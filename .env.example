# Copia este archivo a .env y completa los valores.
#   cp .env.example .env

# Puerto/expresión de escucha del gateway
GATEWAY_LISTEN=:8080

# Ruta de la base SQLite (dentro del contenedor: /data/gateway.db)
GATEWAY_DB_PATH=./data/gateway.db

# Token que protege la API /admin. Si está vacío la API admin queda DESACTIVADA.
# Genera uno con: openssl rand -hex 32
GATEWAY_ADMIN_TOKEN=cambiame-por-un-token-largo

# URL pública donde corre este gateway (la que usan tus sistemas para
# recibir los webhooks reenviados, y la base de las URLs de webhook por tenant)
GATEWAY_PUBLIC_BASE_URL=https://gw.tudominio.com

# Timeouts
GATEWAY_UPSTREAM_TIMEOUT=30s
GATEWAY_DELIVER_TIMEOUT=10s

# Worker de reenvío de webhooks
GATEWAY_WORKER_INTERVAL=1s
GATEWAY_WORKER_BATCH=20
GATEWAY_EVENT_RETENTION=168h

# Límites
GATEWAY_MAX_BODY_BYTES=4194304
GATEWAY_AUTH_CACHE_TTL=15s
GATEWAY_DEFAULT_RPS=60
GATEWAY_DEFAULT_BURST=120

# Logging: debug|info|warn|error  /  GATEWAY_LOG_JSON=true para JSON
GATEWAY_LOG_LEVEL=info
GATEWAY_LOG_JSON=false
